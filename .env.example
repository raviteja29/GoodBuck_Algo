# ---- Frontend (build-time; Vite inlines these into the bundle) ----

# Kite API key, used to build the OAuth login URL. Public by nature.
VITE_KITE_API_KEY=your_kite_api_key

# Dev-only: where Vite's /api proxy forwards to. In PRODUCTION the Express
# server serves dist/ and /api from the same origin, so the app's relative
# /api calls just work and no API base URL is needed.
VITE_API_TARGET=http://localhost:5000

# Optional override for the websocket host (host:port, no protocol).
# Leave UNSET in production: the client defaults to window.location.host,
# which is correct while frontend and backend share one Render service.
# Only set this if you ever split them into two services.
# VITE_WS_HOST=

# ---- Backend (premiumtrader-backend/.env) ----
# KITE_API_KEY=
# KITE_API_SECRET=
# PORT=5000
